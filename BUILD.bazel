load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Dependencies for apps
DEP_FOLDERS = [
    "apps",
    "alg",
    "alg/internal_libqhull",
    "alg/marching_squares",
    "frmts/derived",
    "frmts/gtiff",
    "frmts/gtiff/libgeotiff",
    "frmts/gtiff/libtiff",
    "frmts/mem",
    "frmts/hfa",
    "frmts/vrt",
    "gcore",
    "gcore/mdreader",
    "gnm",
    "gnm/gnm_frmts",
    "ogr",
    "ogr/ogrsf_frmts",
    "ogr/ogrsf_frmts/generic",
    "ogr/ogrsf_frmts/mem",
    "ogr/ogrsf_frmts/geojson",
    "ogr/ogrsf_frmts/kml",
    "ogr/ogrsf_frmts/shape",
    "ogr/ogrsf_frmts/csv",
    "ogr/ogrsf_frmts/vrt",
    "ogr/ogrsf_frmts/geojson/libjson",
    "ogr/ogrsf_frmts/mitab",
    "port",
    "third_party/LercLib",
    "third_party/fast_float",
]

filegroup(
    name = "headers",
    srcs = [
        "//{}:headers".format(d)
        for d in DEP_FOLDERS
    ] + [
        "//apps/argparse:headers",
    ],
)

copy_to_directory(
    name = "collect_headers",
    srcs = [":headers"],
    replace_prefixes = {
        "port": "",
        "gcore": "",
        "alg": "",
        "apps": "",
        "ogr": "",
    },
)

cc_library(
    name = "gdal",
    srcs = [
        "//{}".format(d)
        for d in DEP_FOLDERS
    ] + ["//frmts"],
    hdrs = [
        ":headers",
        "//alg:polygonize_polygonizer.cpp",
    ],
    defines = [
        "GDAL_COMPILATION",
        "HAVE_LIBZ",
        "HAVE_CURL",
        "HAVE_SSE_AT_COMPILE_TIME",
        "HAVE_LIBDEFLATE",
        "ZIP_SUPPORT",
        "CPL_LSB=1",
        # Gdal drivers
        "FRMT_gtiff",
        "FRMT_vrt",
        "FRMT_mem",
        # OGR drivers
        "CSV_ENABLED",
        "MEM_ENABLED",
        "KML_ENABLED",
        "VRT_ENABLED",
        "SHAPE_ENABLED",
    ],
    includes = DEP_FOLDERS + [
        "$(GENDIR)/gcore",
        "$(GENDIR)/port",
        "apps/argparse",
        "port",
    ],
    deps = [
        "@curl",
        "@libdeflate_with_gzip//:libdeflate",
        "@proj",
        "@sqlite3",
        "@zlib",
    ],
)
